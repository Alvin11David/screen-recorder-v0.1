# GitHub OAuth — get these from your GitHub App settings
# https://github.com/settings/apps
VITE_GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CLIENT_ID=your_github_client_id

# Google OAuth — get these from Google Cloud Console > Google Auth Platform > Clients
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Java Backend
API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# Password reset email (SMTP) — enable to send real emails instead of logging to console
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_FROM_NAME=ScreenFlow
MAIL_CONSOLE_FALLBACK=true
